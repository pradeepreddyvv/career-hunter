# Career Pipeline Configuration
# Copy to .env and fill in required values

# ── Required ──
PIPELINE_SECRET_KEY=           # Random string for JWT signing + API key encryption (min 32 chars)

# ── Server ──
PIPELINE_HOST=0.0.0.0
PIPELINE_PORT=8000
PIPELINE_DEBUG=false
PIPELINE_ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# ── Database ──
# SQLite (default, zero-config):
PIPELINE_DATABASE_URL=sqlite+aiosqlite:///./data/pipeline.db
# PostgreSQL (production):
# PIPELINE_DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/pipeline

# ── Rate Limiting ──
PIPELINE_RATE_LIMIT_PER_MINUTE=60
PIPELINE_GEMINI_CONCURRENT_LIMIT=5

# ── Background Tasks ──
PIPELINE_MAX_CONCURRENT_PIPELINES=3
PIPELINE_TASK_TIMEOUT_SECONDS=600

# ── AI Model ──
PIPELINE_DEFAULT_GEMINI_MODEL=gemini-2.5-pro
